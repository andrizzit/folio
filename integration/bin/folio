#!/bin/sh

SCRIPT_PATH=$0
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
  SCRIPT_PATH=$(readlink "$SCRIPT_PATH")
  case "$SCRIPT_PATH" in
    /*) ;;
    *) SCRIPT_PATH=$SCRIPT_DIR/$SCRIPT_PATH ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
FOLIO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)

case "${1:-}" in
  "")
    set -- capture
    ;;
  --category|--title|--thread-id|--no-open)
    set -- capture "$@"
    ;;
esac

exec /usr/bin/env python3 "$FOLIO_ROOT/folio.py" "$@"
